{
  "name": "@machhub-dev/sdk-ts",
  "version": "1.2.2",
  "description": "MACHHUB TYPESCRIPT SDK",
  "keywords": [
    "machhub",
    "intellogic technology"
  ],
  "license": "MPL-2.0",
  "author": "Intellogic Technology Sdn Bhd",
  "types": "dist/index.d.ts",
  "main": "dist/cjs/index.js",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && npx tsc && npx tsc --module CommonJS --outDir dist/cjs && node -e \"fs.writeFileSync('dist/cjs/package.json',JSON.stringify({type:'commonjs'})+'\\n')\"",
    "test": "npx tsc && node --test src/**/*.test.mjs",
    "prepublishOnly": "npm test && npm run build"
  },
  "dependencies": {
    "jwt-decode": "^4.0.0",
    "mqtt": "^5.10.4",
    "safe-buffer": "^5.2.1",
    "typescript": "^5.8.3",
    "undici-types": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.5"
  }
}
